+
+describe('docOfChunk і rankOfDocs', () => {
+  it('docOfChunk — розділяє ID за #, повертає частину до неї', () => {
+    expect(docOfChunk('egr#0003')).toBe('egr');
+    expect(docOfChunk('maf#0000')).toBe('maf');
+    expect(docOfChunk('dpf#9999')).toBe('dpf');
+  });
+
+  it('rankOfDocs — знаходить ранг найкращого фрагмента з документів', () => {
+    const list: Array<{ id: string }> = [
+      { id: 'egr#0003' },
+      { id: 'maf#0000' },
+      { id: 'egr#0001' },
+      { id: 'dpf#0002' },
+    ];
+    expect(rankOfDocs(list, ['egr'])).toBe(1); // egr#0003 на першому місці
+    expect(rankOfDocs(list, ['maf'])).toBe(2); // maf#0000 на другому місці
+    expect(rankOfDocs(list, ['dpf'])).toBe(4); // dpf#0002 на четвертому місці
+  });
+
+  it('rankOfDocs — повертає null, якщо жодного документа немає в списку', () => {
+    const list: Array<{ id: string }> = [
+      { id: 'egr#0003' },
+      { id: 'maf#0000' },
+    ];
+    expect(rankOfDocs(list, ['dpf'])).toBe(null);
+    expect(rankOfDocs(list, ['unknown'])).toBe(null);
+  });
+
+  it('rankOfDocs — бере перший за порядком документ з must_cite', () => {
+    const list: Array<{ id: string }> = [
+      { id: 'egr#0003' },
+      { id: 'maf#0000' },
+      { id: 'dpf#0002' },
+    ];
+    // якщо шукаємо за ['dpf', 'egr'], бираємо perший найнижчий — egr на місці 1
+    expect(rankOfDocs(list, ['dpf', 'egr'])).toBe(1);
+    // якщо шукаємо за ['maf', 'dpf'], бираємо перший найнижчий — maf на місці 2
+    expect(rankOfDocs(list, ['maf', 'dpf'])).toBe(2);
+  });
+});
