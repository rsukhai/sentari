diff --git a/src/rag/search.ts b/src/rag/search.ts
index 6f60ccf1..d6a31893 100644
--- a/src/rag/search.ts
+++ b/src/rag/search.ts
@@ -28,6 +28,15 @@ export interface SearchResult {
   readonly fused: { readonly id: string; readonly score: number }[];
 }
 
+export function docOfChunk(chunkId: string): string {
+  return chunkId.split('#')[0] ?? '';
+}
+
+export function rankOfDocs(list: readonly { id: string }[], docs: readonly string[]): number | null {
+  const i = list.findIndex((r) => docs.includes(docOfChunk(r.id)));
+  return i < 0 ? null : i + 1;
+}
+
 export function bm25From(index: IndexFile): Bm25Index {
   // шукаємо по тому ж тексту, що й ембедимо: заголовок усередині фрагмента — навмисно
   return buildBm25(index.chunks.map((c) => ({ id: c.id, text: c.text })));
